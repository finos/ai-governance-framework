{
  // Ignore generated local virtualenvs, dependency trees, and other tool
  // caches so the repo's markdown validation only sees source content, not
  // runtime artifacts.
  "ignores": [
    "**/.venv/**",
    ".lokf/.venv/**",
    "**/node_modules/**",
    // Agent skills are installed at run time, never committed; they are
    // upstream prose, not this repo's content.
    "**/.agents/**",
    "**/.claude/**",
    // knowledge_bundle is a symlink to .lokf/knowledge (the Obsidian vault
    // entry point, see ktl-sidecar Step 2) - the same files already
    // linted at their real path.
    "knowledge_bundle/**",
    // Generated by the LinkML toolchain or copied from the template, not
    // written here: the docs site's element pages, the copier template's
    // doc templates and the generated project files.
    "linkml/docs/elements/**",
    "linkml/docs/templates-linkml/**",
    "linkml/project/**",
    "linkml/examples/output/**",
    "linkml/.venv/**",
    // What website/ generates from the files above, which are linted where they are.
    "website/dist/**",
    "website/public/**",
    "website/src/content/**",
    "website/src/generated/**"
  ],
  // Rules disabled for reasons specific to this repo's content, not because
  // the underlying style guidance is wrong in general:
  "config": {
    // LOKF concept prose is deliberately unwrapped (agents and diff review don't benefit from a fixed 80-col
    // wrap the way terminal output does).
    "MD013": false,
    // Every LOKF/OKF concept file's frontmatter carries a `title:` field that
    // markdownlint treats as an implicit H1, so the body's own section
    // headings (`# Overview`, `# Services`, ...) read as "duplicate"
    // top-level headings. That frontmatter/body split is the format's actual
    // convention, not a mistake.
    "MD025": false,
    // Two adjacent `>` callouts separated by one blank line are intentionally
    // two distinct blockquotes, not one blockquote with a gap.
    "MD028": false,
    // Angle-bracket placeholder tokens in templates and docs are not HTML.
    "MD033": false,
    // The issue and pull-request templates under .github/ are fragments that
    // GitHub renders into a form; they open at "## Summary" rather than a
    // document-level H1 by design.
    "MD041": false,
    // A changelog or concept file repeats the same category headings under
    // each dated section - expected structure, not a duplicate. siblings_only
    // scopes the check to headings sharing a parent, where a real duplicate
    // is still caught.
    "MD024": {
      "siblings_only": true
    },
    // Tables here (and everywhere on GitHub) pair a padded header (`| Col |`)
    // with a bare `|---|` separator row - the GFM convention. MD060 treats
    // that pairing as internally inconsistent and wants the separator padded
    // too, which nobody writes by hand and no other renderer cares about.
    "MD060": false
  }
}
