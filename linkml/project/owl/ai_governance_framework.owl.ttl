<https://w3id.org/lmodel/ai-governance-framework.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/finos/ai-governance-framework/tree/67b8c3257695d5ede09d262798bf28a0e58d4740> ;
	dcterms:title "FINOS AI Governance Framework" ;
	pav:version "v3" ;
	schema1:keywords "AI governance" , "AI risk" , "FINOS" , "financial services" ;
	a owl:Ontology ;
	rdfs:label "ai_governance_framework" ;
	rdfs:seeAlso <https://air-governance-framework.finos.org/> , <https://github.com/finos/ai-governance-framework> , <https://lmodel.github.io/ai-governance-framework> ;
	skos:definition "A LinkML model of the FINOS AI Governance Framework: its risks, mitigations and use cases, the reference files they cite, and the data files beside them. Each class keeps FINOS's keys and values, so FINOS's files are the test data." ;
	skos:note "FINOS tags no v3 release, so the version is the one docs/_config.yml states and the source is the commit that merged it. scripts/check_upstream_release.py reports a new tag, or main changing a path this schema reads." , "JSON Schema generation turns a hyphen in a slot name or an alias into an underscore, so doc-status cannot be a key of the generated schema, and a key named type would project as a false rdf:type. Each slot that differs from FINOS's key lists that key under aliases. scripts/build_catalogue.py renames by that list and adds item_id and source_file, which FINOS's file name states, and tests/test_upstream_tree.py shows that the renaming is one to one. A reference file needs no renaming." ;
	ai_governance_framework:upstream_commit "67b8c3257695d5ede09d262798bf28a0e58d4740" ;
	ai_governance_framework:upstream_license "CC-BY-4.0" ;
	ai_governance_framework:upstream_release_date "2026-10-26" .
