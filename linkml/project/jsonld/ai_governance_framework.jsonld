  "classes": [
    {
      "name": "AigfCatalogue",
      "definition_uri": "https://w3id.org/lmodel/ai-governance-framework/AigfCatalogue",
      "description": "One edition of the framework, as the facts FINOS's front matter and data files state.",
      "comments": [
        "The bodies of the risk, mitigation and use case pages stay in FINOS's files, which source_file names. The catalogue names each reference file's entries by key and leaves their titles there."
      ],
      "from_schema": "https://w3id.org/lmodel/ai-governance-framework",
      "slots": [
        "AigfCatalogue_title",
        "AigfCatalogue_version",
        "AigfCatalogue_release_date",
        "AigfCatalogue_source_commit",
        "reference_lenses",
        "reference_indexes",
        "AigfCatalogue_risks",
        "AigfCatalogue_mitigations",
        "use_cases",
        "financial_data_classification",
        "ai_use_cases",
        "cross_cutting_capabilities",
        "ai_deployment_model_taxonomy"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/ai-governance-framework/AigfCatalogue",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "AigfItem",
      "definition_uri": "https://w3id.org/lmodel/ai-governance-framework/AigfItem",
      "description": "A page of the framework that its front matter describes and that others cite by identifier.",
      "from_schema": "https://w3id.org/lmodel/ai-governance-framework",
      "abstract": true,
      "slots": [
        "item_id",
        "sequence",
        "AigfItem_title",
        "layout",
        "doc_status",
        "source_file"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/ai-governance-framework/AigfItem",
      "@type": "ClassDefinition"
    },
    {
      "name": "AigfReferenceCitations",
      "definition_uri": "https://w3id.org/lmodel/ai-governance-framework/AigfReferenceCitations",
      "description": "The entries of FINOS's reference files that a page cites, one list for each file.",
      "from_schema": "https://w3id.org/lmodel/ai-governance-framework",
      "mixin": true,
      "slots": [
        "atr_references",
        "canada_regulations_references",
        "eu_ai_act_references",
        "ffiec_itbooklets_references",
        "iosco_supervisory_toolkit_references",
        "iso_42001_references",
        "nist_ai_600_1_references",
        "nist_sp_800_53r5_references",
        "owasp_asi_references",
        "owasp_llm_references",
        "owasp_ml_references",
        "sr11_7_references",
        "uk_regulations_references"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/ai-governance-framework/AigfReferenceCitations",
      "@type": "ClassDefinition"
    },
    {
      "name": "AigfRisk",
      "definition_uri": "https://w3id.org/lmodel/ai-governance-framework/AigfRisk",
