    {
      "name": "AigfMitigation",
      "definition_uri": "https://w3id.org/lmodel/ai-governance-framework/AigfMitigation",
      "description": "A mitigation the framework names, from a file under docs/_mitigations/.",
      "comments": [
        "CONVENTIONS.md makes the link one way: a mitigation lists the risks it mitigates, and a risk does not list its mitigations."
      ],
      "from_schema": "https://w3id.org/lmodel/ai-governance-framework",
      "close_mappings": [
        "airo:RiskControl"
      ],
      "related_mappings": [
        "nexus:Action"
      ],
      "is_a": "AigfItem",
      "mixins": [
        "AigfReferenceCitations"
      ],
      "slots": [
        "sequence",
        "AigfItem_title",
        "doc_status",
        "mitigation_type",
        "mitigation_domain",
        "mitigates",
        "related_mitigations",
